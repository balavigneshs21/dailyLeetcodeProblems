class Solution {
    public int[] dailyTemperatures(int[] nums) {
        int result[]=new int[nums.length];
        int stack[]=new int[nums.length];
        int index=-1;
        for(int i=0;i<nums.length;i++){
            while(index>=0&&nums[stack[index]]<nums[i]){
                result[stack[index]]=i-stack[index];
                index--;
            }
            stack[++index]=i;
        }
        return result;
        
    }
}
