class Solution {
    public int heightChecker(int[] heights) {
        int sort[]=new int[heights.length];
        for(int i=0;i<sort.length;i++)sort[i]=heights[i];
        Arrays.sort(sort);
        int nonEqual=0;
        for(int i=0;i<sort.length;i++){
            if(heights[i]!=sort[i])nonEqual++;
        }
        return nonEqual;
        
    }
}
