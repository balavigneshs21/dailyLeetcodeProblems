class Solution {
    public int maxProfit(int[] prices) {
        int profit=0;
        int buyingPrice=prices[0];
        for(int i=1;i<prices.length;i++){
            if(prices[i]<buyingPrice){
                buyingPrice=prices[i];
            }
            else{
                profit+=prices[i]-buyingPrice;
                buyingPrice=prices[i];
            }
        }
        return profit;

        
    }
}
