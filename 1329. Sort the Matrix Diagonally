class Solution {
    public int[][] diagonalSort(int[][] mat) {
        for(int k=0;k<Math.min(mat.length,mat[0].length);k++){
            for(int i=0;i<mat.length;i++){
                for(int j=0;j<mat[0].length;j++){
                    if(i<mat.length-1&&j<mat[0].length-1&&mat[i][j]>mat[i+1][j+1]){
                        int temp=mat[i][j];
                        mat[i][j]=mat[i+1][j+1];
                        mat[i+1][j+1]=temp;
                    }
                }
            }
        }
        return mat;
        
    }
}
