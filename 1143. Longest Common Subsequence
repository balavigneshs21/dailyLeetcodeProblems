class Solution {
    public int longestCommonSubsequence(String text1, String text2) {
        int dp[][]=new int[text1.length()][text2.length()];//LCS
        for(int i=0;i<dp.length;i++){
            for(int j=0;j<dp[0].length;j++){
                dp[i][j]=-1;
            }
        }
        return memoization(text1,text1.length()-1,text2,text2.length()-1,dp); 
    }
    int memoization(String str1,int index1,String str2,int index2,int dp[][]){
        if(index1<0||index2<0)return 0;//prevents out of index;
        if(dp[index1][index2]!=-1)return dp[index1][index2];//memoization
        if(str1.charAt(index1)==str2.charAt(index2)){//match
            return dp[index1][index2]=1+memoization(str1,index1-1,str2,index2-1,dp);
        }                                                                             //not match
        return dp[index1][index2]=0+Math.max(memoization(str1,index1-1,str2,index2,dp),
        memoization(str1,index1,str2,index2-1,dp));
    }
}
