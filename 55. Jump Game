class Solution {
    public boolean canJump(int[] nums) {
        if(nums.length==1&&nums[0]>=0)return true; 
        int max=0;
        for(int i=0;i<nums.length;i++){
            int jump=i+nums[i];
            if(jump>max)max=jump;  
            if(max>=nums.length-1)return true;
            if(i>=max)return false;
        }
        return true;        
    }
}
