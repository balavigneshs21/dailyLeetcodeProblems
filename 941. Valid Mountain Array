class Solution {
    public boolean validMountainArray(int[] arr) {
        int i=1;
        while(i<arr.length&&arr[i]>arr[i-1])i++;
        if(i==1||i==arr.length)return false;
        // boolean decrement=false;
        while(i<arr.length&&arr[i]<arr[i-1]){
            // decrement=true;
            i++;
        }
        // if(decrement==false)return false;
        return i==arr.length;
        
    }
}
